# Serves the built SPA inside the ui image and proxies /api to the api
# container beside it, so the image is a complete origin on its own.
#
# API_URL is the api's address as seen from this container, for example
# http://api:3000, and is passed as an environment variable.

:5173 {
	root * /srv

	encode gzip zstd

	# The api mounts its own routes under /api, so the prefix is forwarded
	# as-is rather than stripped.
	handle /api/* {
		reverse_proxy {env.API_URL}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
