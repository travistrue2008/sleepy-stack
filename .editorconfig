root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# matches `max-len` in eslint.config.mjs
[*.{js,jsx,mjs,cjs,ts,tsx}]
max_line_length = 80

# trailing double spaces are significant (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# generated by drizzle-kit; leave its formatting alone
[packages/db/migrations/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[bun.lock]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
