{
  /*
   * Shared compiler options for every package. Each package's own
   * tsconfig.json extends this and adds only what genuinely differs:
   * `lib` and `types` (api/db are Bun + ES2022, ui is DOM), `jsx` for ui,
   * and its own `include`.
   *
   * `include` deliberately does NOT live here. Paths in a tsconfig resolve
   * relative to the file that declares them, so an inherited `include` would
   * be interpreted against the repo root rather than the package.
   *
   * Named tsconfig.base.json rather than tsconfig.json so nothing picks it up
   * implicitly: a root tsconfig.json would become an ambient project for
   * every stray .ts in the repo, including scripts/, which no
   * package config currently covers.
   */
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
  },
}
